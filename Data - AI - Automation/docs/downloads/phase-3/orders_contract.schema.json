{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saifulshuvo.com/contracts/orders-v1.schema.json",
  "title": "Orders row contract v1",
  "description": "Machine-readable row contract for the Phase 3 textile-wholesaler orders dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id", "order_date", "customer_id", "region", "segment", "channel",
    "category", "product", "quantity", "unit_price", "discount", "unit_cost",
    "status", "promised_days", "delivery_days", "revenue"
  ],
  "properties": {
    "order_id": {"type": "integer", "minimum": 1},
    "order_date": {"type": "string", "pattern": "^2025-[0-9]{2}-[0-9]{2}$"},
    "customer_id": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "segment": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "enum": ["Phone", "Sales rep", "Portal"]},
    "category": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "quantity": {"type": "integer", "minimum": 1},
    "unit_price": {"type": "number", "exclusiveMinimum": 0},
    "discount": {"type": "number", "minimum": 0, "maximum": 0.08},
    "unit_cost": {"type": "number", "exclusiveMinimum": 0},
    "status": {"type": "string", "enum": ["Delivered", "Cancelled", "Shipped", "Pending"]},
    "promised_days": {"type": "integer", "minimum": 1},
    "delivery_days": {"type": ["integer", "null"], "minimum": 0},
    "revenue": {"type": "number", "minimum": 0}
  }
}
